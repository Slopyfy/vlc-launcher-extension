<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-VlcLauncherService-3242089a-895f-4020-9fb7-065e16ffb3b9</UserSecretsId>
    <AssemblyName>VlcLauncherService</AssemblyName>
    <ApplicationIcon>..\icons\icon128.ico</ApplicationIcon>
    <Company>Binarique Ltd</Company>
    <Copyright>Copyright © Binarique Ltd 2026</Copyright>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0</AssemblyVersion>
    <FileVersion>0.3.0</FileVersion>
    <Product>VLC Launcher Service</Product>
